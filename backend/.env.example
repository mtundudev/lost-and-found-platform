# ==========================================
# Lost & Found Platform - Environment Config
# ==========================================
#
# SETUP:
# 1. Copy this file and rename the copy to: .env
# 2. Open the .env file.
# 3. Replace the placeholder values with your
#    PostgreSQL credentials.
# 4. Create the "lost_and_found" database.
# 5. Replace SECRET_KEY with your own secure key.
# 6. NEVER commit or push the .env file.
#
# ==========================================

# Application
APP_NAME=Lost and Found Platform
APP_ENV=development
DEBUG=True

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/lost_and_found

# Authentication
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30